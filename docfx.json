{
  "build": {
    "markdownEngineProperties": {
      "alerts": {
        "Did You Know?": "alert alert-success"
      }
    },
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "docs/**",
          "pdmpublisher-site/**",
          "pdmpublisher-site-*/**",
          "pdmpublisher.com/**",
          "src-fr-ca/**",
          "src-de-de/**",
          "src-pt-br/**",
          "src/introduction.md",
          "src/pdmpublisher*.md",
          "src/propertiespagepdmpublisher.md",
          "src/licensespdmpublisher.md",
          "src/options.md",
          "src/annotations.md",
          "src/task-integrations.md",
          "src/conditions.md",
          "src/conditions_solidworks.md",
          "src/scheduleditems.md",
          "src/changeslog.md",
          "src/eula.md",
          "src/installingpdmaddins.md",
          "src/offlineactivator.md",
          "src/cdpdm.md",
          "src/cdpdmchangeslog.md",
          "src/updateaddinswithcdpdm.md",
          "src/pdmqa.md",
          "src/pdmpublisher-options/**",
          "src/pdmpublisher-annotations/**",
          "src/pdmpublisher-conditions/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "pdmdeploy/**",
          "downloads/**"
        ],
        "exclude": [
          "images/pdmpublisher/**"
        ]
      }
    ],
    "sitemap": {
      "baseUrl": "https://docs.bluebyte.biz",
      "priority": 1,
      "changefreq": "weekly"
    },
    "output": "docs",
    "template": [
      "default",
      "modern",
      "templates/bluebyte"
    ],
    "globalMetadata": {
      "_appName": "Help Center",
      "_appTitle": "Help Center",
      "_appFooter": "<div class='bbs-site-footer' style='width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);text-align:center;'>&copy; 2026 Blue Byte Systems Inc. All rights reserved.</div>",
      "_appLogoPath": "images/bluebyte-mark.png",
      "_appFaviconPath": "images/bluebyte-mark.png",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
