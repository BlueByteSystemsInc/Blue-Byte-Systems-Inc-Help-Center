{
  "build": {
    "markdownEngineProperties": {
      "alerts": {
        "Le saviez-vous?": "alert alert-success"
      }
    },
    "content": [
      {
        "files": ["index.md", "toc.yml"],
        "src": "pdmpublisher-site-fr-ca"
      },
      {
        "files": ["toc.yml", "welcome.md"],
        "src": "pdmpublisher-site-fr-ca/src",
        "dest": "src"
      },
      {
        "files": [
          "introduction.md",
          "pdmpublisher*.md",
          "propertiespagepdmpublisher.md",
          "licensespdmpublisher.md",
          "options.md",
          "annotations.md",
          "conditions.md",
          "conditions_solidworks.md",
          "scheduleditems.md",
          "changeslog.md",
          "eula.md",
          "installingpdmaddins.md",
          "offlineactivator.md",
          "cdpdm.md",
          "cdpdmchangeslog.md",
          "updateaddinswithcdpdm.md",
          "pdmqa.md",
          "pdmpublisher-options/**/*.md",
          "pdmpublisher-annotations/**/*.md",
          "pdmpublisher-conditions/**/*.md"
        ],
        "src": "src-fr-ca",
        "dest": "src"
      }
    ],
    "resource": [],
    "sitemap": {
      "baseUrl": "https://pdmpublisher.com/help/fr-ca",
      "priority": 1,
      "changefreq": "weekly"
    },
    "output": "pdmpublisher.com/help/fr-ca",
    "template": ["default", "modern", "templates/bluebyte"],
    "globalMetadata": {
      "_appName": "Aide de PDMPublisher",
      "_appTitle": "Centre d’aide PDMPublisher",
      "_appFooter": "<div class='bbs-site-footer' style='width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);text-align:center;'>&copy; 2026 Blue Byte Systems Inc. Tous droits réservés.</div>",
      "_appLogoPath": "https://pdmpublisher.com/help/images/pdmpublisher_logo.png",
      "_appFaviconPath": "https://pdmpublisher.com/help/images/bluebyte-mark.png",
      "_enableSearch": true,
      "_pdmpublisherOnly": true,
      "_lang": "fr-CA",
      "pdf": false
    }
  }
}
